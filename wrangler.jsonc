{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "metonoia",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
